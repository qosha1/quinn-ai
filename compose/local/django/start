#!/bin/bash

set -o errexit
set -o nounset

# Run database migrations
echo "Running database migrations..."
python manage.py migrate --noinput

# Collect static files
echo "Collecting static files..."
python manage.py collectstatic --noinput --clear

# Create superuser if it doesn't exist (development only)
python manage.py shell << END
from django.contrib.auth import get_user_model
User = get_user_model()
if not User.objects.filter(email='admin@example.com').exists():
    User.objects.create_superuser('admin@example.com', 'admin')
    print('Created superuser: admin@example.com / admin')
END

# Start Django development server with hot reload
echo "Starting Django development server..."
python manage.py runserver 0.0.0.0:8000
