# QuinnAI — local development environment template
#
# Copy this file to .env in the same directory and fill in real values:
#   cp .envs/.local/.env.example .envs/.local/.env
#
# .env is gitignored; this .example file IS tracked in git (keep secrets out).

# -------------------------------------------------------------------------
# Provider credentials
# -------------------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# -------------------------------------------------------------------------
# Org context (optional)
# -------------------------------------------------------------------------
# Override automatic org discovery (which walks up from cwd looking for live/quinn.db).
# QUINN_ORG_PATH=/absolute/path/to/your/org

# Required for `qn wrkr` and `msgr`. Normally set inside a worker session;
# set here only if acting as a specific worker from your own shell.
# QUINN_WORKER_ID=wrkr-xxxxxxxx

# -------------------------------------------------------------------------
# Beads — managed by cli/core/bd_wrapper.py per invocation. Don't set manually.
# -------------------------------------------------------------------------
