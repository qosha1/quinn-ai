# Traefik Settings - Production
# Copy this file to .traefik and update ALL values
# NEVER commit the actual .traefik file to version control

# Domain Configuration
DOMAIN_NAME=yourdomain.com

# Let's Encrypt Email (for SSL certificates)
LETSENCRYPT_EMAIL=admin@yourdomain.com

# Traefik Dashboard Authentication
# Generate with: echo $(htpasswd -nb admin your_password) | sed -e s/\\$/\\$\\$/g
# Or use: python -c "import bcrypt; print(bcrypt.hashpw(b'your_password', bcrypt.gensalt()).decode())"
TRAEFIK_DASHBOARD_AUTH=admin:$$apr1$$abc123$$xyz789
