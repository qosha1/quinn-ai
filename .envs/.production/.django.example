# Django Settings - Production
# Copy this file to .django and update ALL values
# NEVER commit the actual .django file to version control

# General
DEBUG=False
SECRET_KEY=CHANGE_THIS_TO_A_LONG_RANDOM_STRING_IN_PRODUCTION
ALLOWED_HOSTS=yourdomain.com,api.yourdomain.com

# Database
# Use DATABASE_URL for production (more secure)
DATABASE_URL=postgres://username:password@postgres:5432/dbname

# Redis
REDIS_URL=redis://redis:6379/0

# Celery
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Email (Production - Use real SMTP or service like SendGrid, Mailgun)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=apikey
EMAIL_HOST_PASSWORD=your_sendgrid_api_key
DEFAULT_FROM_EMAIL=noreply@yourdomain.com
SERVER_EMAIL=server@yourdomain.com

# CORS Settings
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://app.yourdomain.com
CORS_ALLOW_CREDENTIALS=True

# Django Admin (Obscure the admin URL for security)
DJANGO_ADMIN_URL=secure-admin-path-change-this/

# Security (Production - Strict)
CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://api.yourdomain.com,https://app.yourdomain.com
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_BROWSER_XSS_FILTER=True
SECURE_CONTENT_TYPE_NOSNIFF=True

# Stripe (Production keys from https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_live_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_production_webhook_secret

# JWT Settings
JWT_ACCESS_TOKEN_LIFETIME=5
JWT_REFRESH_TOKEN_LIFETIME=1440

# File Storage (AWS S3 - Recommended for production)
USE_S3=True
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_STORAGE_BUCKET_NAME=your-s3-bucket-name
AWS_S3_REGION_NAME=us-east-1
AWS_S3_CUSTOM_DOMAIN=cdn.yourdomain.com

# Or use local storage if not using S3
# USE_S3=False
# MEDIA_ROOT=/app/mediafiles
# STATIC_ROOT=/app/staticfiles

# Logging
LOG_LEVEL=INFO

# Sentry (Optional - for error tracking)
# SENTRY_DSN=https://your_sentry_dsn@sentry.io/project_id

# Domain for Traefik/SSL
DOMAIN_NAME=yourdomain.com
